+    <string name="privacy_policy_intro">GGUF Studio \u092E\u0947\u0902 \u0906\u092A\u0915\u093E \u0938\u094D\u0935\u093E\u0917\u0924 \u0939\u0948! \u092E\u0948\u0902 \u0905\u092A\u0928\u0947 \u0910\u092A \u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930\u0928\u0947 \u0935\u093E\u0932\u0947 \u0939\u0930 \u0935\u094D\u092F\u0915\u094D\u0924\u093F \u0915\u093E \u0935\u093F\u0936\u094D\u0935\u093E\u0938 \u0914\u0930 \u092D\u0930\u094B\u0938\u093E \u092C\u0928\u093E\u090F \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u092A\u094D\u0930\u0924\u093F\u092C\u0926\u094D\u0927 \u0939\u0942\u0902\u0964 \u092F\u0939 \u0917\u094B\u092A\u0928\u0940\u092F\u0924\u093E \u0928\u0940\u0924\u093F \u092C\u0924\u093E\u0924\u0940 \u0939\u0948 \u0915\u093F \u0910\u092A \u0915\u094D\u092F\u093E \u090F\u0915\u0924\u094D\u0930 \u0915\u0930\u0924\u093E \u0939\u0948 \u0914\u0930 \u0915\u094D\u092F\u093E \u0928\u0939\u0940\u0902, \u0906\u092A\u0915\u0940 \u092C\u093E\u0924\u091A\u0940\u0924 \u0915\u0948\u0938\u0947 \u0906\u092A\u0915\u0947 \u0921\u093F\u0935\u093E\u0907\u0938 \u092A\u0930 \u0939\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948, \u0914\u0930 \u0935\u0947 \u0915\u0941\u091B \u0938\u0940\u092E\u093F\u0924 \u0938\u094D\u0925\u093F\u0924\u093F\u092F\u093E\u0901 \u2014 \u091C\u0948\u0938\u0947 \u0935\u0948\u0915\u0932\u094D\u092A\u093F\u0915 \u0935\u0947\u092C \u091F\u0942\u0932 \u2014 \u091C\u093F\u0928\u092E\u0947\u0902 \u091C\u093E\u0928\u0915\u093E\u0930\u0940 \u0906\u092A\u0915\u0947 \u0921\u093F\u0935\u093E\u0907\u0938 \u0938\u0947 \u092C\u093E\u0939\u0930 \u091C\u093E\u0924\u0940 \u0939\u0948, \u0924\u093E\u0915\u093F \u0906\u092A\u0915\u094B \u0939\u092E\u0947\u0936\u093E \u092A\u0924\u093E \u0930\u0939\u0947 \u0915\u093F \u0915\u094D\u092F\u093E \u0905\u092A\u0947\u0915\u094D\u0937\u093F\u0924 \u0939\u0948\u0964</string>
     <string name="privacy_policy_s1_title">1. \u0915\u094B\u0908 \u0935\u094D\u092F\u0915\u094D\u0924\u093F\u0917\u0924 \u091C\u093E\u0928\u0915\u093E\u0930\u0940 \u0938\u0902\u0917\u094D\u0930\u0939 \u0928\u0939\u0940\u0902</string>
-    <string name="privacy_policy_s1_body">\u092E\u0948\u0902, Andriy Druk, LM Playground \u0915\u093E \u0921\u0947\u0935\u0932\u092A\u0930, \u0905\u092A\u0928\u0947 \u0910\u092A \u0915\u0947 \u0909\u092A\u092F\u094B\u0917\u0915\u0930\u094D\u0924\u093E\u0913\u0902 \u0938\u0947 \u0915\u094B\u0908 \u092D\u0940 \u0935\u094D\u092F\u0915\u094D\u0924\u093F\u0917\u0924 \u091C\u093E\u0928\u0915\u093E\u0930\u0940 \u090F\u0915\u0924\u094D\u0930, \u0938\u0902\u0917\u094D\u0930\u0939\u0940\u0924, \u0909\u092A\u092F\u094B\u0917 \u092F\u093E \u0938\u093E\u091D\u093E \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093E\u0964 \u0915\u094B\u0908 \u0916\u093E\u0924\u093E \u0928\u0939\u0940\u0902, \u0915\u094B\u0908 \u0935\u093F\u091C\u094D\u091E\u093E\u092A\u0928 \u0928\u0939\u0940\u0902, \u0914\u0930 \u0915\u094B\u0908 \u0909\u092A\u092F\u094B\u0917 \u090F\u0928\u093E\u0932\u093F\u091F\u093F\u0915\u094D\u0938 \u092F\u093E \u091F\u094D\u0930\u0948\u0915\u093F\u0902\u0917 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0910\u092A \u0906\u092A\u0915\u0940 \u0917\u094B\u092A\u0928\u0940\u092F\u0924\u093E \u0915\u094B \u092A\u094D\u0930\u093E\u0925\u092E\u093F\u0915\u0924\u093E \u0926\u0947\u0915\u0930 \u0921\u093F\u091C\u093C\u093E\u0907\u0928 \u0915\u093F\u092F\u093E \u0917\u092F\u093E \u0939\u0948, \u0924\u093E\u0915\u093F \u0906\u092A \u0907\u0938\u0947 \u0905\u092A\u0928\u0947 \u0935\u094D\u092F\u0915\u094D\u0924\u093F\u0917\u0924 \u0921\u0947\u091F\u093E \u0938\u0947 \u0938\u092E\u091D\u094C\u0924\u093E \u0915\u093F\u090F \u092C\u093F\u0928\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930 \u0938\u0915\u0947\u0902\u0964</string>
+    <string name="privacy_policy_s1_body">\u092E\u0948\u0902, Andriy Druk, GGUF Studio \u0915\u093E \u0921\u0947\u0935\u0932\u092A\u0930, \u0905\u092A\u0928\u0947 \u0910\u092A \u0915\u0947 \u0909\u092A\u092F\u094B\u0917\u0915\u0930\u094D\u0924\u093E\u0913\u0902 \u0938\u0947 \u0915\u094B\u0908 \u092D\u0940 \u0935\u094D\u092F\u0915\u094D\u0924\u093F\u0917\u0924 \u091C\u093E\u0928\u0915\u093E\u0930\u0940 \u090F\u0915\u0924\u094D\u0930, \u0938\u0902\u0917\u094D\u0930\u0939\u0940\u0924, \u0909\u092A\u092F\u094B\u0917 \u092F\u093E \u0938\u093E\u091D\u093E \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093E\u0964 \u0915\u094B\u0908 \u0916\u093E\u0924\u093E \u0928\u0939\u0940\u0902, \u0915\u094B\u0908 \u0935\u093F\u091C\u094D\u091E\u093E\u092A\u0928 \u0928\u0939\u0940\u0902, \u0914\u0930 \u0915\u094B\u0908 \u0909\u092A\u092F\u094B\u0917 \u090F\u0928\u093E\u0932\u093F\u091F\u093F\u0915\u094D\u0938 \u092F\u093E \u091F\u094D\u0930\u0948\u0915\u093F\u0902\u0917 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0910\u092A \u0906\u092A\u0915\u0940 \u0917\u094B\u092A\u0928\u0940\u092F\u0924\u093E \u0915\u094B \u092A\u094D\u0930\u093E\u0925\u092E\u093F\u0915\u0924\u093E \u0926\u0947\u0915\u0930 \u0921\u093F\u091C\u093C\u093E\u0907\u0928 \u0915\u093F\u092F\u093E \u0917\u092F\u093E \u0939\u0948, \u0924\u093E\u0915\u093F \u0906\u092A \u0907\u0938\u0947 \u0905\u092A\u0928\u0947 \u0935\u094D\u092F\u0915\u094D\u0924\u093F\u0917\u0924 \u0921\u0947\u091F\u093E \u0938\u0947 \u0938\u092E\u091D\u094C\u0924\u093E \u0915\u093F\u090F \u092C\u093F\u0928\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930 \u0938\u0915\u0947\u0902\u0964</string>
     <string name="privacy_policy_s2_title">2. \u0921\u093F\u0935\u093E\u0907\u0938 \u092A\u0930 \u092A\u094D\u0930\u094B\u0938\u0947\u0938\u093F\u0902\u0917</string>
     <string name="privacy_policy_s2_body">\u0906\u092A\u0915\u0940 \u092C\u093E\u0924\u091A\u0940\u0924, \u0938\u093F\u0938\u094D\u091F\u092E \u092A\u094D\u0930\u0949\u092E\u094D\u092A\u094D\u091F \u0914\u0930 \u092E\u0949\u0921\u0932 \u0915\u0947 \u091C\u0935\u093E\u092C \u0906\u092A\u0915\u0947 \u0921\u093F\u0935\u093E\u0907\u0938 \u092A\u0930 \u0939\u0940 \u0911\u0928-\u0921\u093F\u0935\u093E\u0907\u0938 \u092E\u0949\u0921\u0932 \u0926\u094D\u0935\u093E\u0930\u093E \u0938\u094D\u0925\u093E\u0928\u0940\u092F \u0930\u0942\u092A \u0938\u0947 \u092A\u094D\u0930\u094B\u0938\u0947\u0938 \u0939\u094B\u0924\u0947 \u0939\u0948\u0902\u0964 \u092F\u0939 \u0938\u093E\u092E\u0917\u094D\u0930\u0940 \u0907\u0928\u092B\u093C\u0930\u0947\u0902\u0938 \u0915\u0947 \u0932\u093F\u090F \u0915\u092D\u0940 \u092E\u0941\u091D\u0947 \u092F\u093E \u0915\u093F\u0938\u0940 \u0938\u0930\u094D\u0935\u0930 \u0915\u094B \u0928\u0939\u0940\u0902 \u092D\u0947\u091C\u0940 \u091C\u093E\u0924\u0940\u0964 \u091C\u092C \u0924\u0915 \u0906\u092A \u0907\u0902\u091F\u0930\u0928\u0947\u091F \u0924\u0915 \u092A\u0939\u0941\u0901\u091A\u0928\u0947 \u0935\u093E\u0932\u0940 \u0915\u093F\u0938\u0940 \u0938\u0941\u0935\u093F\u0927\u093E \u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947, \u092F\u0939 \u0906\u092A\u0915\u0947 \u0921\u093F\u0935\u093E\u0907\u0938 \u092A\u0930 \u0939\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948, \u091C\u0948\u0938\u093E \u0915\u093F \u0928\u0940\u091A\u0947 \u092C\u0924\u093E\u092F\u093E \u0917\u092F\u093E \u0939\u0948\u0964</string>
     <string name="privacy_policy_s3_title">3. \u0907\u0902\u091F\u0930\u0928\u0947\u091F \u090F\u0915\u094D\u0938\u0947\u0938</string>
-    <string name="privacy_policy_s3_body">LM Playground \u0926\u094B \u0909\u0926\u094D\u0926\u0947\u0936\u094D\u092F\u094B\u0902 \u0915\u0947 \u0932\u093F\u090F \u0907\u0902\u091F\u0930\u0928\u0947\u091F \u0905\u0928\u0941\u092E\u0924\u093F \u092E\u093E\u0901\u0917\u0924\u093E \u0939\u0948: \u0906\u092A\u0915\u0947 \u091A\u0941\u0928\u0947 \u0917\u090F \u092E\u0949\u0921\u0932 \u092B\u093C\u093E\u0907\u0932\u0947\u0902 \u0921\u093E\u0909\u0928\u0932\u094B\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F, \u0914\u0930 \u2014 \u0915\u0947\u0935\u0932 \u091C\u092C \u0906\u092A \u0909\u0928\u094D\u0939\u0947\u0902 \u091A\u093E\u0932\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0935\u0948\u0915\u0932\u094D\u092A\u093F\u0915 \u0935\u0947\u092C \u091F\u0942\u0932 \u091A\u0932\u093E\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F\u0964 \u0910\u092A \u092E\u0947\u0902 \u0915\u094B\u0908 \u0935\u093F\u091C\u094D\u091E\u093E\u092A\u0928, \u091F\u0947\u0932\u0940\u092E\u0947\u091F\u094D\u0930\u0940 \u092F\u093E \u0909\u092A\u092F\u094B\u0917 \u090F\u0928\u093E\u0932\u093F\u091F\u093F\u0915\u094D\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0914\u0930 \u092F\u0939 \u0906\u092A\u0915\u0940 \u0917\u0924\u093F\u0935\u093F\u0927\u093F \u0915\u0940 \u091C\u093E\u0928\u0915\u093E\u0930\u0940 \u092E\u0941\u091D\u0947 \u0935\u093E\u092A\u0938 \u0928\u0939\u0940\u0902 \u092D\u0947\u091C\u0924\u093E\u0964</string>
+    <string name="privacy_policy_s3_body">GGUF Studio \u0926\u094B \u0909\u0926\u094D\u0926\u0947\u0936\u094D\u092F\u094B\u0902 \u0915\u0947 \u0932\u093F\u090F \u0907\u0902\u091F\u0930\u0928\u0947\u091F \u0905\u0928\u0941\u092E\u0924\u093F \u092E\u093E\u0901\u0917\u0924\u093E \u0939\u0948: \u0906\u092A\u0915\u0947 \u091A\u0941\u0928\u0947 \u0917\u090F \u092E\u0949\u0921\u0932 \u092B\u093C\u093E\u0907\u0932\u0947\u0902 \u0921\u093E\u0909\u0928\u0932\u094B\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F, \u0914\u0930 \u2014 \u0915\u0947\u0935\u0932 \u091C\u092C \u0906\u092A \u0909\u0928\u094D\u0939\u0947\u0902 \u091A\u093E\u0932\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u2014 \u0935\u0948\u0915\u0932\u094D\u092A\u093F\u0915 \u0935\u0947\u092C \u091F\u0942\u0932 \u091A\u0932\u093E\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F\u0964 \u0910\u092A \u092E\u0947\u0902 \u0915\u094B\u0908 \u0935\u093F\u091C\u094D\u091E\u093E\u092A\u0928, \u091F\u0947\u0932\u0940\u092E\u0947\u091F\u094D\u0930\u0940 \u092F\u093E \u0909\u092A\u092F\u094B\u0917 \u090F\u0928\u093E\u0932\u093F\u091F\u093F\u0915\u094D\u0938 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0914\u0930 \u092F\u0939 \u0906\u092A\u0915\u0940 \u0917\u0924\u093F\u0935\u093F\u0927\u093F \u0915\u0940 \u091C\u093E\u0928\u0915\u093E\u0930\u0940 \u092E\u0941\u091D\u0947 \u0935\u093E\u092A\u0938 \u0928\u0939\u0940\u0902 \u092D\u0947\u091C\u0924\u093E\u0964</string>
