+    // ── Lock-screen generation wake lock ────────────────────────────────
+
+    private fun acquireGenerationWakeLock() {
+        synchronized(wakeLockGuard) {
+            generationWakeLockRefs++
+            if (generationWakeLock == null) {
+                val pm = getSystemService(PowerManager::class.java) ?: return
+                val lock = pm.newWakeLock(
+                    PowerManager.PARTIAL_WAKE_LOCK,
+                    "$TAG:generation",
+                )
+                // refcounted=false + our own ref counter: a lost release
+                // (e.g. service kill racing a binder callback) can never
+                // permanently pin the CPU.
+                lock.setReferenceCounted(false)
+                lock.acquire(GENERATION_WAKE_LOCK_TIMEOUT_MS)
+                generationWakeLock = lock
+            }
+        }
+    }
+
+    /**
+     * Releases the wake lock once the last active generation worker
+     * exits. [force] (used from [onDestroy]) drops it immediately
+     * regardless of the refcount.
+     */
+    private fun releaseGenerationWakeLock(force: Boolean = false) {
+        synchronized(wakeLockGuard) {
+            if (force) generationWakeLockRefs = 0
+            else if (generationWakeLockRefs > 0) generationWakeLockRefs--
+            if (generationWakeLockRefs <= 0) {
+                generationWakeLock?.let {
+                    try {
+                        if (it.isHeld) it.release()
+                    } catch (_: Throwable) {
+                        // already released by the system timeout — fine
+                    }
+                }
+                generationWakeLock = null
+            }
+        }
+    }
