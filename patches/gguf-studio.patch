     <string name="privacy_policy_s4_body">\u0938\u0915\u094D\u0937\u092E \u092E\u0949\u0921\u0932 \u0935\u0948\u0915\u0932\u094D\u092A\u093F\u0915 \u091F\u0942\u0932 \u0915\u093E \u0909\u092A\u092F\u094B\u0917 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u091C\u094B \u0921\u093F\u092B\u093C\u0949\u0932\u094D\u091F \u0930\u0942\u092A \u0938\u0947 \u092C\u0902\u0926 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u091C\u092C \u0906\u092A \u0935\u0947\u092C \u091F\u0942\u0932 \u091A\u093E\u0932\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094B \u0915\u0941\u091B \u091C\u093E\u0928\u0915\u093E\u0930\u0940 \u0906\u092A\u0915\u0947 \u0921\u093F\u0935\u093E\u0907\u0938 \u0938\u0947 \u092C\u093E\u0939\u0930 \u091C\u093E\u0924\u0940 \u0939\u0948: \u0935\u0947\u092C \u0916\u094B\u091C \u091F\u0942\u0932 \u092E\u0949\u0921\u0932 \u0915\u0940 \u0916\u094B\u091C \u0915\u094D\u0935\u0947\u0930\u0940 DuckDuckGo \u0915\u094B \u092D\u0947\u091C\u0924\u093E \u0939\u0948, \u0914\u0930 \u0935\u0947\u092C \u092A\u0947\u091C \u092B\u093C\u0947\u091A \u0915\u0930\u0947\u0902 \u091F\u0942\u0932 \u0909\u0928 \u0935\u0947\u092C\u0938\u093E\u0907\u091F\u094B\u0902 \u0938\u0947 \u0935\u0947 \u092A\u0947\u091C \u0921\u093E\u0909\u0928\u0932\u094B\u0921 \u0915\u0930\u0924\u093E \u0939\u0948 \u091C\u093F\u0928\u094D\u0939\u0947\u0902 \u092E\u0949\u0921\u0932 \u0916\u094B\u0932\u0928\u0947 \u0915\u093E \u0928\u093F\u0930\u094D\u0923\u092F \u0932\u0947\u0924\u093E \u0939\u0948\u0964 \u0935\u0947 \u0905\u0928\u0941\u0930\u094B\u0927 \u0924\u0940\u0938\u0930\u0947 \u092A\u0915\u094D\u0937 \u0915\u0940 \u0938\u093E\u0907\u091F\u094B\u0902 \u0926\u094D\u0935\u093E\u0930\u093E \u0909\u0928\u0915\u0940 \u0905\u092A\u0928\u0940 \u0917\u094B\u092A\u0928\u0940\u092F\u0924\u093E \u0928\u0940\u0924\u093F\u092F\u094B\u0902 \u0915\u0947 \u0924\u0939\u0924 \u0938\u0902\u092D\u093E\u0932\u0947 \u091C\u093E\u0924\u0947 \u0939\u0948\u0902 \u2014 \u092E\u0941\u091D\u0947 \u0928 \u0924\u094B \u0935\u0947 \u092E\u093F\u0932\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0928 \u092E\u0948\u0902 \u0909\u0928\u094D\u0939\u0947\u0902 \u0938\u0902\u0917\u094D\u0930\u0939\u0940\u0924 \u0915\u0930\u0924\u093E \u0939\u0942\u0902\u0964 JavaScript \u091A\u0932\u093E\u090F\u0901 \u091F\u0942\u0932 \u092A\u0942\u0930\u0940 \u0924\u0930\u0939 \u0906\u092A\u0915\u0947 \u0921\u093F\u0935\u093E\u0907\u0938 \u092A\u0930 \u090F\u0915 \u0938\u0948\u0902\u0921\u092C\u0949\u0915\u094D\u0938 \u092E\u0947\u0902 \u091A\u0932\u0924\u093E \u0939\u0948 \u091C\u093F\u0938\u092E\u0947\u0902 \u0907\u0902\u091F\u0930\u0928\u0947\u091F \u090F\u0915\u094D\u0938\u0947\u0938 \u0928\u0939\u0940\u0902 \u0939\u094B\u0924\u093E\u0964 \u0938\u092C \u0915\u0941\u091B \u0911\u092B\u093C\u0932\u093E\u0907\u0928 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F, \u092C\u0938 \u091F\u0942\u0932 \u092C\u0902\u0926 \u0930\u0939\u0928\u0947 \u0926\u0947\u0902\u0964</string>
