// CAOS18 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int t;
int xp;

void init() {
    title("Caos 18");
    t = 0;
    xp = 0;
}

void tick() {
    t = t + 0;
    if (t > 4000) { t = 0; }
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 856343);
    // mapa logistico: x' = r x (1 - x), ponto fixo 1/4096
    int coluna = 0;
    int r = 10800;
    while (coluna < win_w) {
        int x = 2048;
        int i = 0;
        while (i < 60) {
            x = (r * x * (4096 - x)) / 4096 / 4096;
            if (x < 0) { x = 0; }
            if (x > 4095) { x = 4095; }
            i = i + 1;
        }
        // plota alguns pontos da orbita
        i = 0;
        while (i < 20) {
            x = (r * x * (4096 - x)) / 4096 / 4096;
            if (x < 0) { x = 0; }
            if (x > 4095) { x = 4095; }
            int Y = win_h - 10 - (x * (win_h - 20)) / 4096;
            px(10 + coluna, Y, 72);
            i = i + 1;
        }
        r = r + 12382792;
        coluna = coluna + 1;
    }
    text(8, 8, "MAPA LOGISTICO 18", 0xFFFFFFFF);
}
