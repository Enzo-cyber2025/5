// TERMO17 — gerado por tools/genapps.py (categoria MATH)

int segm[16];
int vals[6];
int linha[34];

int t;

void init() {
    seg_init();
    title("Termos 17");
}

void tick() {
    t = t + 1;
    if (t > 120) { t = -40; }
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(16, 12, "ESCALA DE TEMPERATURA", 15265012);
    // termometro: -40 C a 120 C
    int y0 = 40;
    int y1 = 220;
    rect(60, y0, 26, y1 - y0, 2765123);
    int nivel = y1 - (t + 40) * (y1 - y0) / 160;
    rect(56, nivel, 34, y1 - nivel, 3994172);
    rect(50, y1 - 8, 46, 16, 3994172);
    // marcas
    int m = -40;
    while (m <= 120) {
        int my = y1 - (m + 40) * (y1 - y0) / 160;
        line(88, my, 96, my, 15265012);
        m = m + 20;
    }
    text(120, 60, "Celsius:", 15265012);
    segnum(210, 52, t, 3, 15907193, 0);
    text(120, 100, "Fahrenheit:", 15265012);
    segnum(240, 92, t * 9 / 5 + 32, 3, 15907193, 0);
    text(120, 140, "Kelvin:", 15265012);
    segnum(210, 132, t + 273, 3, 15907193, 0);
    // estado
    if (t <= 0) { text(120, 180, "CONGELANDO", 7324671); }
    else if (t >= 100) { text(120, 180, "FERVENDO", 16743001); }
    else { text(120, 180, "liquido", 9081765); }
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
