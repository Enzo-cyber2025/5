// ADIV14 — gerado por tools/genapps.py (categoria JOGO)

int segm[16];
int vals[6];
int linha[34];

int segredo;
int lo; int hi;
int chute;
int tentativas;
int fase;   // 0 chutando, 1 acertou
int semente;

void init() {
    seg_init();
    title("Adivinha 14");
    semente = uptime() | 1;
    nova();
}

int rnd(int m) {
    semente = semente * 1664525 + 1013904223;
    if (semente < 0) { semente = 0 - semente; }
    return (semente / 65536) % m;
}

void nova() {
    segredo = 1 + rnd(499);
    lo = 1;
    hi = 500;
    chute = (lo + hi) / 2;
    tentativas = 0;
    fase = 0;
}

void tick() {
    if (fase == 1) { return; }
    tentativas = tentativas + 1;
    if (chute == segredo) {
        fase = 1;
        beep(880, 80);
    } else if (chute < segredo) {
        lo = chute + 1;
    } else {
        hi = chute - 1;
    }
    chute = (lo + hi) / 2;
    if (lo > hi) { fase = 1; }
    invalidate();
}

void mouse(int x, int y, int b, int pr) {
    if (pr != 1) { return; }
    nova();
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(16, 12, "ADVINHADOR — busca binaria animada", 15265012);
    text(16, 44, "intervalo:", 15265012);
    segnum(130, 36, lo, 3, 9402866, 0);
    segnum(210, 36, hi, 3, 9402866, 0);
    text(16, 92, "chute:", 15265012);
    segnum(110, 84, chute, 3, 9402866, 0);
    text(16, 140, "tentativas:", 15265012);
    segnum(140, 132, tentativas, 2, 9402866, 0);
    // barra do intervalo
    rect(30, 190, win_w - 60, 18, 2765123);
    int bw = (win_w - 60) / 500;
    rect(30 + (lo - 1) * bw, 186, (hi - lo + 1) * bw, 26, 3419225);
    // agulha do chute
    int cx = 30 + (chute - 1) * bw + bw / 2;
    rect(cx - 2, 180, 4, 38, 16777215);
    if (fase == 1) {
        text(16, 236, "ACHEI! clique para novo numero", 7331978);
    }
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
