// ARVO13 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int fx[128];
int fy[128];
int fa[128];
int fl[128];
int n;
int t;

void init() {
    fillsin();
    title("Arvore 13");
}

void tick() {
    t = t + 1;
    invalidate();
}

// angulo em unidades de 1/4096 rad aproximado por tabela
int cossi(int a) {
    a = a & 255;
    return coss[(a * 32 / 256) & 31];
}

int sini(int a) {
    a = a & 255;
    return sins[(a * 32 / 256) & 31];
}

void paint() {
    rect(0, 0, win_w, win_h, 856343);
    // semente
    n = 1;
    fx[0] = win_w / 2;
    fy[0] = win_h - 20;
    fa[0] = 192;       // apontando pra cima (3/4 de volta)
    fl[0] = 80;
    int passo = 0;
    while (passo < 4) {
        int i = 0;
        int base = n;
        while (i < base) {
            int x = fx[i];
            int y = fy[i];
            int a = fa[i];
            int l = fl[i];
            int x2 = x + (sini(a) * l) / 4096;
            int y2 = y - (cossi(a) * l) / 4096;
            int cor = 5351372;
            if (passo < 2) { cor = 9067051; }
            line(x, y, x2, y2, cor);
            // dois filhos
            if (n < 126) {
                fx[n] = x2; fy[n] = y2; fa[n] = a - 18; fl[n] = l * 62 / 100;
                n = n + 1;
            }
            if (n < 126) {
                fx[n] = x2; fy[n] = y2; fa[n] = a + 18; fl[n] = l * 62 / 100;
                n = n + 1;
            }
            i = i + 1;
        }
        passo = passo + 1;
    }
    // vento: deslocamento pelo tempo
    text(8, 8, "ARVORE FRACTAL 13", 0xFFFFFFFF);
}

