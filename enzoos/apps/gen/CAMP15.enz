// CAMP15 — gerado por tools/genapps.py (categoria JOGO)

int segm[16];
int vals[6];
int linha[34];

int minas[81];
int abertas[81];
int vivas;
int abriu;
int semente;
int bandeiras;

void init() {
    seg_init();
    title("Campo 15");
    semente = uptime() | 1;
    gera();
}

int rnd(int m) {
    semente = semente * 1664525 + 1013904223;
    if (semente < 0) { semente = 0 - semente; }
    return (semente / 65536) % m;
}

void gera() {
    int i = 0;
    while (i < 81) { minas[i] = 0; abertas[i] = 0; i = i + 1; }
    int m = 0;
    while (m < 16) {
        int pos = rnd(81);
        if (minas[pos] == 0) { minas[pos] = 1; m = m + 1; }
    }
    vivas = 1;
    abriu = 0;
    bandeiras = 16;
}

int vizinhas(int idx) {
    int l = idx / 9;
    int c = idx % 9;
    int n = 0;
    int dl = -1;
    while (dl <= 1) {
        int dc = -1;
        while (dc <= 1) {
            int nl = l + dl;
            int nc = c + dc;
            if (nl >= 0 && nl < 9 && nc >= 0 && nc < 9) {
                if (minas[nl * 9 + nc] == 1) { n = n + 1; }
            }
            dc = dc + 1;
        }
        dl = dl + 1;
    }
    return n;
}

void mouse(int x, int y, int b, int pr) {
    if (pr != 1) { return; }
    if (vivas == 0) { gera(); invalidate(); return; }
    int c = (x - 20) / 40;
    int l = (y - 40) / 40;
    if (c < 0 || c > 8 || l < 0 || l > 8) { return; }
    int idx = l * 9 + c;
    if (abertas[idx] != 0) { return; }
    abertas[idx] = 1;
    abriu = abriu + 1;
    if (minas[idx] == 1) {
        vivas = 0;
        beep(200, 150);
    } else if (abriu >= 81 - 16) {
        vivas = 0;
        beep(990, 80);
    } else {
        beep(700, 12);
    }
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(12, 10, "CAMPO MINADO — clique abre", 15265012);
    int i = 0;
    while (i < 81) {
        int x = 20 + (i % 9) * 40;
        int y = 40 + (i / 9) * 40;
        if (abertas[i] == 0) {
            rect(x, y, 38, 38, 5712985);
            rect(x + 3, y + 3, 32, 32, 7423090);
        } else if (minas[i] == 1) {
            rect(x, y, 38, 38, 11546688);
            rect(x + 14, y + 14, 10, 10, 1712176);
        } else {
            int n = vizinhas(i);
            rect(x, y, 38, 38, 1712691);
            if (n > 0) {
                // n pontos
                int j = 0;
                while (j < n) {
                    rect(x + 6 + j * 6, y + 16, 4, 4, 7330047);
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    text(12, 375, "abertas:", 15265012);
    segnum(90, 367, abriu, 2, 15265012, 0);
    if (vivas == 0) { text(160, 375, "FIM — clique reinicia", 16743001); }
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
