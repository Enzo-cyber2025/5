// PITA08 — gerado por tools/genapps.py (categoria MATH)

int segm[16];
int vals[6];
int linha[34];

int achados;
int ua; int ub; int uc;

void init() {
    seg_init();
    title("Pitagoras 8");
    calcula();
}

void calcula() {
    achados = 0;
    int a = 1;
    while (a < 18) {
        int b = a;
        while (b < 18) {
            int c2 = a * a + b * b;
            int c = b;
            while (c * c < c2) { c = c + 1; }
            if (c * c == c2) {
                achados = achados + 1;
                ua = a; ub = b; uc = c;
            }
            b = b + 1;
        }
        a = a + 1;
    }
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(16, 12, "TERNOS PITAGORICOS", 15265012);
    text(16, 44, "achados:", 15265012);
    segnum(120, 36, achados, 3, 15890871, 0);
    text(16, 92, "ultimo: a b c", 15265012);
    segnum(120, 84, ua, 2, 15890871, 0);
    segnum(180, 84, ub, 2, 15890871, 0);
    segnum(240, 84, uc, 2, 15890871, 0);
    // triangulo
    int ox = 80;
    int oy = 250;
    int s = 4;
    line(ox, oy, ox + ua * s, oy, 16752453);
    line(ox, oy, ox, oy - ub * s, 5219296);
    line(ox, oy - ub * s, ox + ua * s, oy, 16752453);
    rect(ox - 3, oy + 3, 6, 6, 15265012);
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
