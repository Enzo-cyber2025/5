int a1x; int a1y;
int a2x; int a2y;
int t;

void init() {
    fillsin();
    title("Espiro 13");
    a1x = 4096; a1y = 0;
    a2x = 4096; a2y = 0;
}

void tick() {
    int i = 0;
    while (i < 1) {
        int nx = a1x - (a1y * 9) / 4096 / 60;
        int ny = a1y + (a1x * 9) / 4096 / 60;
        a1x = nx; a1y = ny;
        int mx = a2x - (a2y * 16) / 4096 / 60;
        int my = a2y + (a2x * 16) / 4096 / 60;
        a2x = mx; a2y = my;
        t = t + 1;
        i = i + 1;
    }
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 856343);
    int i = 0;
    int px0 = 0; int py0 = 0;
    while (i < 180) {
        int X = win_w / 2 + (a1x * (win_w / 2 - 15)) / 4096 + (a2x * 20) / 4096;
        int Y = win_h / 2 + (a1y * (win_h / 2 - 15)) / 4096 + (a2y * 20) / 4096;
        if (i > 0) { line(px0, py0, X, Y, 15878318); }
        px0 = X; py0 = Y;
        int nx = a1x - (a1y * 9) / 4096 / 60;
        int ny = a1y + (a1x * 9) / 4096 / 60;
        a1x = nx; a1y = ny;
        int mx = a2x - (a2y * 16) / 4096 / 60;
        int my = a2y + (a2x * 16) / 4096 / 60;
        a2x = mx; a2y = my;
        i = i + 1;
    }
    text(8, 8, "ESPIROGRAFO 13", 0xFFFFFFFF);
}

