// ASCII04 — gerado por tools/genapps.py (categoria UTIL)

int segm[16];
int vals[6];
int linha[34];

void init() {
    seg_init();
    title("Ascii 4");
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    int COL = 8536063;
    text(16, 10, "TABELA ASCII (parte)", 15265012);
    text(16, 30, "A  065  B  066  C  067  D  068", COL);
    text(16, 46, "E  069  F  070  G  071  H  072", COL);
    text(16, 62, "I  073  J  074  K  075  L  076", COL);
    text(16, 78, "M  077  N  078  O  079  P  080", COL);
    text(16, 94, "Q  081  R  082  S  083  T  084", COL);
    text(16, 110, "U  085  V  086  W  087  X  088", COL);
    text(16, 126, "Y  089  Z  090  [  091  \  092", COL);
    text(16, 142, "a  097  b  098  c  099  d  100", COL);
    text(16, 158, "e  101  f  102  g  103  h  104", COL);
    // cursor piscando sobre a linha do meio
    if ((uptime() / 500) % 2 == 0) {
        rect(16, 30 + 3 * 16 - 2, win_w - 32, 14, 8536063);
    }
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
