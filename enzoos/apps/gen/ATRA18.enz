// ATRA18 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int x; int y;
int n;

void init() {
    fillsin();
    title("Atrator 18");
    x = 0;
    y = 0;
    n = 0;
}

int seno(int v) {
    // indexa a tabela por v (0..4095 = volta completa)
    int i = (v / 128) & 31;
    return sins[i];
}

int cosseno(int v) {
    int i = (v / 128) & 31;
    return coss[i];
}

void paint() {
    rect(0, 0, win_w, win_h, 856343);
    int i = 0;
    while (i < 1700) {
        int nx = seno(12 * y / 4096) - cosseno(6 * x / 4096);
        int ny = seno(40 * x / 4096) - cosseno(28 * y / 4096);
        x = nx;
        y = ny;
        int X = win_w / 2 + x * 90 / 4096;
        int Y = win_h / 2 + y * 90 / 4096;
        if (X > 1 && X < win_w - 1 && Y > 1 && Y < win_h - 1) {
            px(X, Y, 3994230);
            px(X + 1, Y, 2329668);
        }
        i = i + 1;
    }
    text(8, 8, "ATRATOR DE JONG 18", 0xFFFFFFFF);
}

