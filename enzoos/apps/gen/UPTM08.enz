// UPTM08 — gerado por tools/genapps.py (categoria UTIL)

int segm[16];
int vals[6];
int linha[34];

void init() {
    seg_init();
    title("Uptime 8");
}

void tick() {
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(16, 12, "UPTIME DO SISTEMA", 15265012);
    int u = uptime();
    segnum(40, 70, u / 3600000, 2, 7336557, 0);
    text(100, 92, "h", 15265012);
    segnum(130, 70, (u / 60000) % 60, 2, 7336557, 0);
    text(190, 92, "m", 15265012);
    segnum(220, 70, (u / 1000) % 60, 2, 7336557, 0);
    text(280, 92, "s", 15265012);
    // barra de minuto
    int f = (u / 1000) % 60;
    rect(30, 160, (win_w - 60) * f / 60, 22, 4390719);
    rect(30, 160, win_w - 60, 22, 2373674);
    // pulsos
    int i = 0;
    while (i < 20) {
        int on = ((u / 250) >> i) & 1;
        if (on == 1) { rect(30 + i * 17, 210, 12, 12, 4390719); }
        else { rect(30 + i * 17, 210, 12, 12, 2373674); }
        i = i + 1;
    }
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
