// ESTR14 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int sx[90];
int sy[90];
int sz[90];
int semente;

void init() {
    title("Estrelas 14");
    semente = uptime() | 1;
    int i = 0;
    while (i < 90) {
        sx[i] = rnd(4096) - 2048;
        sy[i] = rnd(4096) - 2048;
        sz[i] = 64 + rnd(3840);
        i = i + 1;
    }
}

int rnd(int m) {
    semente = semente * 1664525 + 1013904223;
    if (semente < 0) { semente = -semente; }
    return (semente / 65536) % m;
}

void tick() {
    int i = 0;
    while (i < 90) {
        sz[i] = sz[i] - 147;
        if (sz[i] < 32) {
            sz[i] = 3904;
            sx[i] = rnd(4096) - 2048;
            sy[i] = rnd(4096) - 2048;
        }
        i = i + 1;
    }
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 856344);
    int i = 0;
    while (i < 90) {
        int z = sz[i];
        int X = win_w / 2 + (sx[i] * 300) / z;
        int Y = win_h / 2 + (sy[i] * 300) / z;
        if (X > 0 && X < win_w && Y > 0 && Y < win_h) {
            int t = 4 - z / 1000;
            if (t < 1) { t = 1; }
            if (t > 4) { t = 4; }
            rect(X, Y, t, t, 15265012);
            if (t >= 3) { rect(X + t, Y, 1, 1, 10467032); rect(X - 1, Y, 1, 1, 10467032); }
        }
        i = i + 1;
    }
    text(8, 8, "CAMPO ESTELAR 14", 0xFFFFFFFF);
}
