// ONDA13 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int t;

void init() {
    title("Ondas 13");
}

void tick() {
    t = t + 3;
    invalidate();
}

void paint() {
    int y = 0;
    while (y < win_h) {
        int x = 0;
        while (x < win_w) {
            int d1 = (x - win_w / 4) * (x - win_w / 4) + (y - win_h / 2) * (y - win_h / 2);
            int d2 = (x - 3 * win_w / 4) * (x - 3 * win_w / 4) + (y - win_h / 2) * (y - win_h / 2);
            int v = (d1 / 744 + t) ^ (d2 / 598 - t);
            v = v & 255;
            int r = 36 + v / 2;
            int g = 84 + v;
            int b = 104 + (v * 3) / 2;
            if (r > 255) { r = 255; }
            if (g > 255) { g = 255; }
            if (b > 255) { b = 255; }
            px(x, y, 0xFF000000 | (r << 16) | (g << 8) | b);
            x = x + 1;
        }
        y = y + 1;
    }
    text(8, 8, "INTERFERENCIA 13", 0xFFFFFFFF);
}
