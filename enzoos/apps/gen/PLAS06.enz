// PLAS06 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int t;

void init() {
    fillsin();
    title("Plasma 6");
}

void tick() {
    t = t + 1;
    invalidate();
}

int pal(int v) {
    v = v & 255;
    // rampa harmonica 6
    int r = v;
    int g = (v * 2) & 255;
    int b = (v * 4) & 255;
    return 0xFF000000 | (r << 16) | (g << 8) | b;
}

void paint() {
    int y = 0;
    while (y < win_h) {
        int x = 0;
        while (x < win_w) {
            int v;
            v = ((x - win_w/2) * (x - win_w/2) / 105) ^ ((y - win_h/2) * (y - win_h/2) / 55) ^ t;
            px(x, y, pal(v));
            x = x + 1;
        }
        y = y + 1;
    }
    text(8, 8, "PLASMA 6", 0xFFFFFFFF);
}

