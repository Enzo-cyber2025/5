// CONV16 — gerado por tools/genapps.py (categoria MATH)

int segm[16];
int vals[6];
int linha[34];

int v;

void init() {
    seg_init();
    title("Converte 16");
    v = 555;
}

void tick() {
    v = v + 1;
    if (v > 60000) { v = 0; }
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(16, 12, "CONVERSOR DEC / HEX / BIN", 15265012);
    text(16, 44, "dec:", 15265012);
    segnum(90, 36, v, 5, 15887758, 0);
    text(16, 100, "hex:", 15265012);
    // 4 digitos hexa
    int i = 3;
    while (i >= 0) {
        int d = (v >> (i * 4)) & 15;
        seg1(90 + (3 - i) * 22, 92, d, 15887758);
        i = i - 1;
    }
    text(16, 160, "bin:", 15265012);
    int j = 15;
    while (j >= 0) {
        int on = (v >> j) & 1;
        if (on == 1) { rect(90 + (15 - j) * 12, 168, 8, 14, 16727919); }
        else { rect(90 + (15 - j) * 12, 168, 8, 14, 3679780); }
        j = j - 1;
    }
    text(16, 220, "cada app desta serie conta numa velocidade", 10847372);
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
