// METRO12 — gerado por tools/genapps.py (categoria UTIL)

int segm[16];
int vals[6];
int linha[34];

int bpm;
int t0;
int ligado;
int batida;

void init() {
    seg_init();
    fillsin();
    title("Metronomo 12");
    bpm = 192;
    t0 = uptime();
}

void mouse(int x, int y, int b, int pr) {
    if (pr != 1) { return; }
    if (y > win_h - 70) {
        if (x > win_w - 90) { ligado = 1 - ligado; }
        else if (x > win_w / 2) { bpm = bpm + 5; }
        else { bpm = bpm - 5; }
        if (bpm < 30) { bpm = 30; }
        if (bpm > 300) { bpm = 300; }
        invalidate();
    }
}

void tick() {
    if (ligado == 0) { return; }
    int intervalo = 60000 / bpm;
    int agora = uptime();
    if (agora - t0 >= intervalo) {
        t0 = agora;
        batida = 1 - batida;
        beep(605, 40);
        invalidate();
    }
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(16, 12, "METRONOMO", 15265012);
    segnum(120, 70, bpm, 3, 15891565, 0);
    text(200, 92, "BPM", 15265012);
    rect(20, win_h - 60, 120, 44, 2903377);
    text(48, win_h - 46, "MENOS", 15265012);
    rect(150, win_h - 60, 120, 44, 2903377);
    text(178, win_h - 46, "MAIS", 15265012);
    rect(win_w - 90, win_h - 60, 70, 44, 2903377);
    if (ligado == 1) { text(win_w - 82, win_h - 46, "PAUSA", 15265012); }
    else { text(win_w - 82, win_h - 46, "TOCA", 15265012); }
    // pendulo
    int a = 0;
    if (ligado == 1) { a = (batida * 2 - 1) * 10; }
    int px = win_w / 2 + coss[(a + 16) & 31] * 90 / 4096;
    int py = 60 - coss[(a + 16) & 31] * 10 / 4096;
    line(win_w / 2, 40, px, 150, 15265012);
    rect(px - 6, 150, 12, 12, 16733759);
}
