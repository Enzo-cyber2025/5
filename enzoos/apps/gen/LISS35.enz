// LISS35 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int ax; int ay;
int bx; int by;
int t;
int trilho[512];

void init() {
    fillsin();
    title("Lissajous 35");
    ax = 4096; ay = 0;
    bx = 0; by = 4096;
    t = 0;
}

void tick() {
    int i = 0;
    while (i < 2) {
        // fasores girando com frequencias diferentes (ponto fixo)
        int nax = ax - (ay * 11) / 4096 / 60;
        int nay = ay + (ax * 11) / 4096 / 60;
        ax = nax; ay = nay;
        int nbx = bx - (by * 7) / 4096 / 60;
        int nby = by + (bx * 7) / 4096 / 60;
        bx = nbx; by = nby;
        t = t + 1;
        i = i + 1;
    }
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 856343);
    int i = 0;
    int px0 = 0; int py0 = 0;
    while (i < 150) {
        int X = win_w / 2 + (ax * (win_w / 2 - 20)) / 4096;
        int Y = win_h / 2 + (by * (win_h / 2 - 20)) / 4096;
        if (i > 0) {
            line(px0, py0, X, Y, 4780724);
        }
        px0 = X; py0 = Y;
        // avanca um passo para desenhar o rastro
        int nax = ax - (ay * 11) / 4096 / 60;
        int nay = ay + (ax * 11) / 4096 / 60;
        ax = nax; ay = nay;
        int nbx = bx - (by * 7) / 4096 / 60;
        int nby = by + (bx * 7) / 4096 / 60;
        bx = nbx; by = nby;
        i = i + 1;
    }
    text(8, 8, "LISSAJOUS 35", 0xFFFFFFFF);
}

