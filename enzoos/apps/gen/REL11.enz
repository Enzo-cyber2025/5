// REL11 — gerado por tools/genapps.py (categoria UTIL)

int segm[16];
int vals[6];
int linha[34];

void init() {
    seg_init();
    fillsin();
    title("Relogio 11");
}

void tick() {
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    time(tbuf);
    // hh:mm:ss nas posições fixas (a string é literal do runtime)
    text(16, 14, "RELOGIO", 15265012);
    // barreira de segundos: pulse
    int u = uptime() / 1000;
    int s = u % 60;
    // mostrador: 6 dígitos h m s
    segnum(40, 90, (u / 3600) % 100, 2, 8647277, 0);
    seg1(96, 90, 10, 8647277);
    segnum(130, 90, (u / 60) % 60, 2, 8647277, 0);
    seg1(186, 90, 10, 8647277);
    segnum(220, 90, s, 2, 8647277, 0);
    // pontos da segundos
    int i = 0;
    while (i < 60) {
        int a = i * 6;
        int on = 0;
        if (i <= s) { on = 1; }
        int cx = win_w / 2 + (coss[a & 31] * 150) / 4096;
        int cy = 70 + (sins[a & 31] * 150) / 4096 / 2;
        if (on == 1) { rect(cx, cy, 4, 4, 6291263); }
        else { rect(cx, cy, 3, 3, 2373671); }
        i = i + 1;
    }
}
