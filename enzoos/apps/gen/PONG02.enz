// PONG02 — gerado por tools/genapps.py (categoria JOGO)

int segm[16];
int vals[6];
int linha[34];

int py1; int py2;
int bx; int by;
int vx; int vy;
int s1; int s2;
int t0;
int passo;

void init() {
    seg_init();
    title("Pong 2");
    py1 = 120; py2 = 120;
    bx = 200; by = 150;
    vx = 4; vy = 3;
    s1 = 0; s2 = 0;
    t0 = uptime();
}

void key(int k) {
    if (k == 119 || k == 87) { py1 = py1 - 14; }
    if (k == 115 || k == 83) { py1 = py1 + 14; }
    if (py1 < 30) { py1 = 30; }
    if (py1 > 250) { py1 = 250; }
    invalidate();
}

void tick() {
    passo = passo + 1;
    if (passo < 1) { return; }
    passo = 0;
    bx = bx + vx;
    by = by + vy;
    if (by < 34) { by = 34; vy = -vy; }
    if (by > 290) { by = 290; vy = -vy; }
    if (bx < 30 && by > py1 && by < py1 + 60) { bx = 30; vx = -vx; beep(600, 15); }
    if (bx > 380 && by > py2 && by < py2 + 60) { bx = 380; vx = -vx; }
    if (bx < 10) { s2 = s2 + 1; bx = 200; by = 150; vx = 4; }
    if (bx > 400) { s1 = s1 + 1; bx = 200; by = 150; vx = -4; beep(600, 40); }
    // cpu segue
    if (py2 + 30 > by) { py2 = py2 - 3; }
    if (py2 + 30 < by) { py2 = py2 + 3; }
    if (py2 < 30) { py2 = 30; }
    if (py2 > 250) { py2 = 250; }
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(10, 8, "PONG — W/S move a raquete esquerda", 15265012);
    line(210, 30, 210, 300, 3752794);
    rect(20, py1, 8, 60, 7330047);
    rect(392, py2, 8, 60, 16758861);
    rect(bx - 5, by - 5, 10, 10, 16777215);
    segnum(150, 12, s1, 2, 15265012, 0);
    segnum(250, 12, s2, 2, 15265012, 0);
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
