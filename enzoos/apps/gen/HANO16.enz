// HANO16 — gerado por tools/genapps.py (categoria JOGO)

int segm[16];
int vals[6];
int linha[34];

// torres: pino -> disco -> tamanho (0 = vazio)
int torre[24];
int ndiscos;
int movimentos;
int total;
int de; int para;
int fase;
int t0;

void init() {
    seg_init();
    title("Hanoi 16");
    ndiscos = 3;
    total = 1;
    int i = 0;
    while (i < ndiscos) {
        torre[i] = ndiscos - i;
        torre[8 + i] = 0;
        torre[16 + i] = 0;
        i = i + 1;
    }
    movimentos = 0;
    fase = 0;
    t0 = uptime();
}

int topo(int p) {
    int i = 0;
    while (i < 8) {
        if (torre[p * 8 + i] == 0) { return i; }
        i = i + 1;
    }
    return 8;
}

void move(int d, int p) {
    // tira de d
    int td = topo(d) - 1;
    int disco = torre[d * 8 + td];
    torre[d * 8 + td] = 0;
    // poe em p
    int tp = topo(p);
    torre[p * 8 + tp] = disco;
    movimentos = movimentos + 1;
}

void tick() {
    if (fase == 1) { return; }
    if (uptime() - t0 < 320) { return; }
    t0 = uptime();
    // solucao iterativa padrao (torre de 3 pinos)
    int jogada = movimentos % 3;
    if (ndiscos % 2 == 0) {
        if (jogada == 0) { de = 0; para = 1; }
        if (jogada == 1) { de = 0; para = 2; }
        if (jogada == 2) { de = 1; para = 2; }
    } else {
        if (jogada == 0) { de = 0; para = 2; }
        if (jogada == 1) { de = 0; para = 1; }
        if (jogada == 2) { de = 1; para = 2; }
    }
    // valida e executa (troca se preciso)
    int vd = topo(de);
    int vp = topo(para);
    if (vd == 0) { return; }
    if (vp != 0 && torre[de * 8 + vd - 1] > torre[para * 8 + vp - 1]) {
        int t = de; de = para; para = t;
    }
    move(de, para);
    if (topo(2) == ndiscos) { fase = 1; beep(880, 120); }
    invalidate();
}

void mouse(int x, int y, int b, int pr) {
    if (pr == 1 && fase == 1) { init(); invalidate(); }
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(12, 10, "TORRE DE HANOI — solucao automatica", 15265012);
    int p = 0;
    while (p < 3) {
        int bx = 60 + p * 130;
        line(bx, 40, bx, 280, 13160672);
        rect(bx - 55, 280, 110, 8, 3752794);
        int i = 0;
        while (i < 8) {
            int d = torre[p * 8 + i];
            if (d != 0) {
                int larg = 14 + d * 12;
                rect(bx - larg / 2, 272 - i * 18, larg, 14, 14177911);
                rect(bx - larg / 2 + 3, 272 - i * 18 + 3, larg - 6, 8, 5691576);
            }
            i = i + 1;
        }
        p = p + 1;
    }
    text(12, 306, "movimentos:", 15265012);
    segnum(120, 298, movimentos, 3, 15265012, 0);
    if (fase == 1) { text(200, 306, "RESOLVIDO! clique reinicia", 7331978); }
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
