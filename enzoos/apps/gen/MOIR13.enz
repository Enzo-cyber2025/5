// MOIR13 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int t;

void init() {
    title("Moire 13");
}

void tick() {
    t = t + 1;
    invalidate();
}

void paint() {
    int y = 0;
    while (y < win_h) {
        int x = 0;
        while (x < win_w) {
            int d1 = ((x - win_w / 3 - t) * (x - win_w / 3 - t) + (y - win_h / 3) * (y - win_h / 3)) / 344;
            int d2 = ((x - 2 * win_w / 3 + t) * (x - 2 * win_w / 3 + t) + (y - 2 * win_h / 3) * (y - 2 * win_h / 3)) / 136;
            int v = (d1 ^ d2) & 63;
            v = v * 4;
            px(x, y, 0xFF000000 | (4 + v << 16) | (28 + v << 8) | (116 + v));
            x = x + 1;
        }
        y = y + 1;
    }
    text(8, 8, "MOIRE 13", 0xFFFFFFFF);
}
