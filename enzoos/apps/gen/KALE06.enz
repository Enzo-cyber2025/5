// KALE06 — gerado por tools/genapps.py (categoria VISUAL)

int segm[16];
int vals[6];
int linha[34];

int t;

void init() {
    title("Caleido 6");
}

void tick() {
    t = t + 1;
    invalidate();
}

int pal(int v) {
    v = v & 255;
    return 0xFF000000 | (v << 16) | ((v * 3) & 255 << 8) | ((v * 2) & 255);
}

void paint() {
    int y = 0;
    while (y < win_h) {
        int x = 0;
        while (x < win_w) {
            int dx = x - win_w / 2;
            if (dx < 0) { dx = -dx; }
            int dy = y - win_h / 2;
            if (dy < 0) { dy = -dy; }
            int v = ((dx * 3 + dy * 10) ^ (dx * dy / 149)) + t;
            // espelha em 3 fatias
            if ((v / 16) % 2 == 0) { v = 255 - v; }
            px(x, y, pal(v));
            x = x + 1;
        }
        y = y + 1;
    }
    text(8, 8, "CALEIDOSCOPIO 6", 0xFFFFFFFF);
}
