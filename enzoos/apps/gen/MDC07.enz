// MDC07 — gerado por tools/genapps.py (categoria MATH)

int segm[16];
int vals[6];
int linha[34];

int a; int b;
int passos;
int semente;

void init() {
    seg_init();
    title("Mdc 7");
    semente = uptime() | 1;
    a = 162;
    b = 114;
}

int rnd(int m) {
    semente = semente * 1664525 + 1013904223;
    if (semente < 0) { semente = 0 - semente; }
    return (semente / 65536) % m;
}

void mouse(int x, int y, int bb, int pr) {
    if (pr != 1) { return; }
    a = 100 + rnd(720);
    b = 100 + rnd(720);
    passos = 0;
    invalidate();
}

void tick() {
    if (a == b) { return; }
    if (a > b) { a = a - b; } else { b = b - a; }
    passos = passos + 1;
    invalidate();
}

void paint() {
    rect(0, 0, win_w, win_h, 1053727);
    text(16, 12, "ALGORITMO DE EUCLIDES (MDC)", 15265012);
    text(16, 46, "a:", 15265012);
    segnum(50, 38, a, 5, 13466098, 0);
    text(180, 46, "b:", 15265012);
    segnum(214, 38, b, 5, 13466098, 0);
    text(16, 100, "subtracoes:", 15265012);
    segnum(140, 92, passos, 3, 13466098, 0);
    text(16, 150, "mdc quando a == b", 9081765);
    // barras proporcionais
    int total = a + b;
    if (total > 0) {
        rect(20, 200, (win_w - 40) * a / total, 20, 11622104);
        rect(20 + (win_w - 40) * a / total, 200, (win_w - 40) * b / total, 20, 8247382);
    }
}

// ---- máscaras 7-seg: bit0 topo,1 sup-dir,2 inf-dir,3 base,4 inf-esq,
// ---- 5 sup-esq,6 meio (hexa completo)
void seg_init() {
    segm[0] = 0x3F;  segm[1] = 0x06;  segm[2] = 0x5B;  segm[3] = 0x4F;
    segm[4] = 0x66;  segm[5] = 0x6D;  segm[6] = 0x7D;  segm[7] = 0x07;
    segm[8] = 0x7F;  segm[9] = 0x6F;  segm[10] = 0x77; segm[11] = 0x7C;
    segm[12] = 0x39; segm[13] = 0x5E; segm[14] = 0x79; segm[15] = 0x71;
}

void seg1(int x, int y, int d, int cor) {
    int m = segm[d & 15];
    int W = 14;
    int H = 24;
    if ((m & 1) != 0) { rect(x + 2, y, W, 3, cor); }
    if ((m & 2) != 0) { rect(x + W, y + 2, 3, H / 2, cor); }
    if ((m & 4) != 0) { rect(x + W, y + H, 3, H / 2, cor); }
    if ((m & 8) != 0) { rect(x + 2, y + H + H, W, 3, cor); }
    if ((m & 16) != 0) { rect(x, y + H, 3, H / 2, cor); }
    if ((m & 32) != 0) { rect(x, y + 2, 3, H / 2, cor); }
    if ((m & 64) != 0) { rect(x + 2, y + H, W, 3, cor); }
}

// desenha v com nd dígitos (sem sinal; se v<0 mostra '-')
void segnum(int x, int y, int v, int nd, int cor, int apag) {
    int i = nd - 1;
    int neg = 0;
    if (v < 0) { neg = 1; v = -v; }
    while (i >= 0) {
        int d = v % 10;
        v = v / 10;
        seg1(x + i * 22, y, d, cor);
        i = i - 1;
    }
    if (neg == 1) { rect(x - 6, y + 20, 4, 4, cor); }
}
