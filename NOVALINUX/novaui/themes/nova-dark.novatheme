# NovaUI theme — Nova Dark
# Formato original .novatheme (claro/escuro). Sem relação com Qt/GTK/EFL.

[meta]
name = "Nova Dark"
author = "Nova Project"
version = 1
kind = dark

[colors]
bg = #1a1b3a
bg_alt = #24264d
fg = #eaeaf2
fg_dim = #a9aac4
accent = #3a0ca3
accent_2 = #7209b7
panel_bg = #12132b
panel_fg = #eaeaf2
selection = #4361ee
border = #3f3f70
terminal_bg = #101020
terminal_fg = #d8d8f0

[fonts]
ui = "DejaVu Sans 11"
mono = "DejaVu Sans Mono 11"
title = "DejaVu Sans Bold 12"

[metrics]
corner_radius = 10
padding = 8
panel_height = 30
wallpaper = "/usr/share/novaui/themes/wallpaper.png"
