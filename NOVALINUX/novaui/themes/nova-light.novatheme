# NovaUI theme — Nova Light
# Formato original .novatheme (claro/escuro). Sem relação com Qt/GTK/EFL.

[meta]
name = "Nova Light"
author = "Nova Project"
version = 1
kind = light

[colors]
bg = #f7f7fb
bg_alt = #eaeaf4
fg = #1c1c2e
fg_dim = #55556e
accent = #4a1fb8
accent_2 = #7906c9
panel_bg = #ffffff
panel_fg = #1c1c2e
selection = #c7d2fe
border = #d2d4ea
terminal_bg = #ffffff
terminal_fg = #1c1c2e

[fonts]
ui = "DejaVu Sans 11"
mono = "DejaVu Sans Mono 11"
title = "DejaVu Sans Bold 12"

[metrics]
corner_radius = 10
padding = 8
panel_height = 30
wallpaper = "/usr/share/novaui/themes/wallpaper.png"
