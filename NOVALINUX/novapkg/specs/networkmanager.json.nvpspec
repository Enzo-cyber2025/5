{
  "arch": "x86_64",
  "build_deps": [
    "autoconf",
    "automake",
    "make",
    "gcc",
    "pkg-config"
  ],
  "configure": "./configure --prefix=/usr --sysconfdir=/etc",
  "depends": [
    "glibc"
  ],
  "description": "Gerenciamento de conex\u00f5es de rede",
  "install_staging": "make install DESTDIR=$STAGE",
  "make": "make -j$(nproc)",
  "name": "networkmanager",
  "optimization": "-O3 -pipe -flto=auto -march=goldmont-plus -mtune=goldmont-plus",
  "source": "https://github.com/NetworkManager/NetworkManager/archive/refs/tags/1.46.0.tar.gz",
  "version": "1.46.0"
}