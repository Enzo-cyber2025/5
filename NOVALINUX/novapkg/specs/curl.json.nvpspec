{
  "arch": "x86_64",
  "build_deps": [
    "autoconf",
    "automake",
    "make",
    "gcc",
    "pkg-config"
  ],
  "configure": "./configure --prefix=/usr --sysconfdir=/etc",
  "depends": [
    "glibc"
  ],
  "description": "Transfer\u00eancia de dados via URL",
  "install_staging": "make install DESTDIR=$STAGE",
  "make": "make -j$(nproc)",
  "name": "curl",
  "optimization": "-O3 -pipe -flto=auto -march=goldmont-plus -mtune=goldmont-plus",
  "source": "https://github.com/curl/curl/archive/refs/tags/curl-8_5_0.tar.gz",
  "version": "8.5.0"
}