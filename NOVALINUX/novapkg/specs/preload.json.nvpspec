{
  "arch": "x86_64",
  "build_deps": [
    "autoconf",
    "automake",
    "make",
    "gcc",
    "pkg-config"
  ],
  "configure": "./configure --prefix=/usr --sysconfdir=/etc",
  "depends": [
    "glibc"
  ],
  "description": "Pr\u00e9-carregamento de bin\u00e1rios para acelerar inicializa\u00e7\u00e3o",
  "install_staging": "make install DESTDIR=$STAGE",
  "make": "make -j$(nproc)",
  "name": "preload",
  "optimization": "-O3 -pipe -flto=auto -march=goldmont-plus -mtune=goldmont-plus",
  "source": "https://github.com/aristofun/preload/archive/refs/tags/v0.6.1.tar.gz",
  "version": "0.6.1"
}