<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.textbinary">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="35" />
    <application android:label="Text to Binary" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
