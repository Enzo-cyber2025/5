<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="48dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/thinkHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_brain"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:text="🧠 Pensou por um momento"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/thinkBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_think"
        android:padding="10dp"
        android:textColor="#92400E"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="raciocínio" />

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_assistant"
        android:padding="12dp"
        android:textColor="#1E293B"
        android:textIsSelectable="true"
        android:textSize="16sp" />
</LinearLayout>
