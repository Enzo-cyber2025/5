<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/dThink"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/chip_think"
            app:chipIcon="@drawable/ic_brain" />

        <com.google.android.material.chip.Chip
            android:id="@+id/dResearch"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/chip_research"
            app:chipIcon="@drawable/ic_search" />

        <com.google.android.material.chip.Chip
            android:id="@+id/dLocked"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="Continuar gerando com a tela bloqueada"
            app:chipIcon="@drawable/ic_lock" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Máx. de tokens por resposta"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/dPredict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_system"
            android:inputType="number"
            android:importantForAutofill="no"
            android:maxLines="1"
            android:padding="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Persona / instrução de sistema"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/dPersona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_system"
            android:gravity="top"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="4"
            android:padding="10dp" />
    </LinearLayout>
</ScrollView>
