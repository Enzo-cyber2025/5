#!/bin/sh
# Initramfs PID 1 — the live root IS this image.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root

[ -d /proc ] || mkdir -p /proc
[ -d /sys ] || mkdir -p /sys
[ -d /dev ] || mkdir -p /dev
[ -d /tmp ] || mkdir -p /tmp
[ -d /run ] || mkdir -p /run

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mount -t tmpfs tmpfs /dev
mkdir -p /dev/pts /dev/shm /dev/input
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

# busybox mdev for input/fb nodes
if [ -x /sbin/mdev ]; then
    echo /sbin/mdev > /proc/sys/kernel/hotplug 2>/dev/null
    mdev -s
fi

ln -sf /proc/self/fd /dev/fd 2>/dev/null
ln -sf /proc/self/fd/0 /dev/stdin 2>/dev/null
ln -sf /proc/self/fd/1 /dev/stdout 2>/dev/null
ln -sf /proc/self/fd/2 /dev/stderr 2>/dev/null

hostname -F /etc/hostname 2>/dev/null || hostname novastation

# nodes the GUI needs even before mdev settles
[ -e /dev/fb0 ] || mknod /dev/fb0 c 29 0 2>/dev/null
[ -e /dev/tty0 ] || mknod /dev/tty0 c 4 0 2>/dev/null
[ -e /dev/tty1 ] || mknod /dev/tty1 c 4 1 2>/dev/null
[ -e /dev/console ] || mknod /dev/console c 5 1 2>/dev/null
[ -e /dev/ptmx ] || mknod /dev/ptmx c 5 2 2>/dev/null
[ -e /dev/null ] || mknod /dev/null c 1 3 2>/dev/null
chmod 666 /dev/ptmx /dev/null /dev/fb0 2>/dev/null
mkdir -p /dev/input /dev/pts
ln -sf /dev/pts/ptmx /dev/ptmx 2>/dev/null || true

BANNER="
========================================
   NovaLinux 1.0   host novastation
   NovaUI starting on tty1
   user nova   password nova123
========================================
"
for c in /dev/console /dev/tty0 /dev/tty1; do
    [ -w "$c" ] && printf '%s\n' "$BANNER" > "$c"
done

# hand off to busybox init + OpenRC runlevels
if [ -x /sbin/init ] && [ /sbin/init != /init ]; then
    exec /sbin/init
fi
exec /bin/busybox init
